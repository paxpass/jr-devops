APP_NAME="Secure Drop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://secure-drop.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=secure_drop
DB_USERNAME=laravel
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_TO_SECURE_REDIS_PASSWORD
REDIS_PORT=6379

BCRYPT_ROUNDS=12